From 52a402eacad184c4d1379ec5f3bd6c9f39a81b8a Mon Sep 17 00:00:00 2001
From: Anish Pallati <i@anish.land>
Date: Sun, 22 Nov 2026 05:29:12 -0500
Subject: [PATCH 1/2] swb: accept toolchains installed without usr/

Signed-off-by: Anish Pallati <i@anish.land>
---
 Sources/XToolSupport/Toolchain.swift | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Sources/XToolSupport/Toolchain.swift b/Sources/XToolSupport/Toolchain.swift
index b2eac36..7cb713e 100644
--- a/Sources/XToolSupport/Toolchain.swift
+++ b/Sources/XToolSupport/Toolchain.swift
@@ -74,6 +74,8 @@ public struct ToolchainProvider: DependencyKey, Sendable {
             trimmed = runtimeResourcePath.dropLast("/usr/lib/swift".count)
         } else if runtimeResourcePath.hasSuffix("/usr/local/lib/swift") {
             trimmed = runtimeResourcePath.dropLast("/usr/local/lib/swift".count)
+        } else if runtimeResourcePath.hasSuffix("/lib/swift") {
+            trimmed = runtimeResourcePath.dropLast("/lib/swift".count)
         } else {
             throw Console.Error("Unexpected toolchain resource path: \(runtimeResourcePath)")
         }
-- 
