From: Anish Pallati <i@anish.land>
Date: Sun, 22 Nov 2026 22:57:42 -0500
Subject: [PATCH] dev: add prepare-packages

Signed-off-by: Anish Pallati <i@anish.land>
---
 Sources/XToolSupport/DevCommand.swift         | 23 +++++++++++++++++++
 .../XToolSupport/XcodeBuildDescriber.swift    | 12 ++++++----
 .../XToolSupport/XcodePackagePIFBuilder.swift | 14 +++++++----
 3 files changed, 39 insertions(+), 10 deletions(-)

diff --git a/Sources/XToolSupport/DevCommand.swift b/Sources/XToolSupport/DevCommand.swift
index c9e4c63..a257f60 100644
--- a/Sources/XToolSupport/DevCommand.swift
+++ b/Sources/XToolSupport/DevCommand.swift
@@ -94,6 +94,28 @@ struct DevXcodeCommand: AsyncParsableCommand {
     }
 }
 
+struct DevPreparePackagesCommand: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(
+        commandName: "prepare-packages",
+        abstract: "Prepare an Xcode project's Swift packages without resolving them"
+    )
+
+    func run() async throws {
+        let project = try await XToolProject.discover(start: URL(filePath: "."))
+        guard case .xcode(let xcode) = project else {
+            throw Console.Error("prepare-packages requires an Xcode project")
+        }
+        let builder = try XcodeBuildDescriber(project: xcode).pifBuilder()
+        guard let directory = try XcodePackagePIFBuilder(
+            builder: builder,
+            rootDirectory: xcode.base.rootDirectory
+        ).prepare() else {
+            throw Console.Error("The Xcode project has no Swift package references")
+        }
+        d.out.print(directory.path)
+    }
+}
+
 struct DevBuildCommand: AsyncParsableCommand {
     static let configuration = CommandConfiguration(
         commandName: "build",
@@ -327,6 +349,7 @@ struct DevCommand: AsyncParsableCommand {
         abstract: "Build and run a Swift package or Xcode project",
         subcommands: [
             DevXcodeCommand.self,
+            DevPreparePackagesCommand.self,
             DevBuildCommand.self,
             DevRunCommand.self,
             DevBSPCommand.self,
diff --git a/Sources/XToolSupport/XcodeBuildDescriber.swift b/Sources/XToolSupport/XcodeBuildDescriber.swift
index 4d470c6..89d08b6 100644
--- a/Sources/XToolSupport/XcodeBuildDescriber.swift
+++ b/Sources/XToolSupport/XcodeBuildDescriber.swift
@@ -9,14 +9,16 @@ struct XcodeBuildDescriber {
     let project: XToolProject.Xcode
     var scheme: String?
 
-    func describe() async throws -> (pif: XPIF.Container, targetSelection: BuildDescription.TargetSelection?) {
+    func pifBuilder() throws -> XcodePIFBuilder {
         let container = project.container
-        let builder: XcodePIFBuilder
         if container.pathExtension == "xcworkspace" {
-            builder = try XcodePIFBuilder(workspace: XcodeWorkspace(url: container))
-        } else {
-            builder = try XcodePIFBuilder(project: XcodeProject(url: container))
+            return try XcodePIFBuilder(workspace: XcodeWorkspace(url: container))
         }
+        return try XcodePIFBuilder(project: XcodeProject(url: container))
+    }
+
+    func describe() async throws -> (pif: XPIF.Container, targetSelection: BuildDescription.TargetSelection?) {
+        let builder = try pifBuilder()
         let packages = try await XcodePackagePIFBuilder(
             builder: builder,
             rootDirectory: project.base.rootDirectory
diff --git a/Sources/XToolSupport/XcodePackagePIFBuilder.swift b/Sources/XToolSupport/XcodePackagePIFBuilder.swift
index 87102bd..7796347 100644
--- a/Sources/XToolSupport/XcodePackagePIFBuilder.swift
+++ b/Sources/XToolSupport/XcodePackagePIFBuilder.swift
@@ -13,11 +13,9 @@ struct XcodePackagePIFBuilder {
     /// Directory under which xtool stores its package resolution scratch space.
     let rootDirectory: URL
 
-    func build() async throws -> [XPIF.Project] {
-        guard !builder.packageReferences.isEmpty else { return [] }
-        let references = builder.packageReferences
-        let manifest = try Self.manifest(references: references)
-        let rootPaths = Self.rootPaths(references)
+    func prepare() throws -> URL? {
+        guard !builder.packageReferences.isEmpty else { return nil }
+        let manifest = try Self.manifest(references: builder.packageReferences)
         // SwiftPM's checkout paths appear in PIF. Keep the workspace stable across builds.
         let key = SHA256.hash(data: Data(builder.packageWorkspaceURL.path.utf8))
             .map { String(format: "%02x", $0) }.joined()
@@ -31,6 +29,12 @@ struct XcodePackagePIFBuilder {
         if let data = try? Data(contentsOf: resolved) {
             try data.write(to: directory.appending(path: "Package.resolved"), options: .atomic)
         }
+        return directory
+    }
+
+    func build() async throws -> [XPIF.Project] {
+        guard let directory = try prepare() else { return [] }
+        let rootPaths = Self.rootPaths(builder.packageReferences)
         @Dependency(\.swiftPMPIFDumper) var dumper
         let pif = try await dumper.dump(packagePath: directory)
         let defaults = try await XcodePackageSDKDefaults.load()
